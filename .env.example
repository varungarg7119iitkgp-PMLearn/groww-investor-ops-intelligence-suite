# =====================================================================
# Investor Ops & Intelligence Suite — Environment Variable Template
# Copy to .env.local and fill in values.
# The deployed Vercel app uses pre-configured keys; evaluators need not
# set these for the public demo (mock/degrade paths apply when missing).
# =====================================================================

# ── Supabase (Phase 7 — Data Layer) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<your-publishable-key>
# Optional — server-side admin writes (eval persistence, reviews ingest, HITL)
# SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>

# ── Google Gemini (Phase 8+ — RAG / pulse / voice orchestration) ───
GEMINI_API_KEY=AIzaSy...

# ── ElevenLabs (Phase 10+ — Voice STT/TTS) ──────────────────────────
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=<voice-id>

# ── Google Calendar Service Account (Phase 10+ — Booking holds) ────
GOOGLE_CLIENT_EMAIL=calendar-sa@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
TARGET_CALENDAR_ID=primary@advisor-calendar
# Optional — force mock calendar when SA keys unavailable (local / eval)
# CALENDAR_MOCK_MODE=true

# ── Jira / Confluence (Phase 7+ — ops ticketing) ───────────────────
JIRA_BASE_URL=https://<your-instance>.atlassian.net/
JIRA_API_TOKEN=<token>
JIRA_USER_EMAIL=<email>
JIRA_PROJECT_KEY=KAN
CONFLUENCE_BASE_URL=https://<your-instance>.atlassian.net/
CONFLUENCE_API_TOKEN=<token>
CONFLUENCE_USER_EMAIL=<email>
CONFLUENCE_SPACE_KEY=PM

# ── Gmail SMTP (Phase 8 — outbound notifications) ──────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<sender-email>
SMTP_PASSWORD=<app-password>

# ── GitHub Actions: scheduled fund refresh ─────────────────────────
# Variables required as repo SECRETS (Settings → Secrets and variables → Actions)
# for the .github/workflows/daily-nav-refresh.yml workflow:
#   - NEXT_PUBLIC_SUPABASE_URL       (same value as above)
#   - NEXT_PUBLIC_SUPABASE_ANON_KEY  (same value as above)
# The cron runs `npm run refresh:funds:ci` which scrapes 20 Groww pages,
# rebuilds the fund_chunks RAG index, and updates NAV in Supabase.

# ── Eval scripts (Phase 15) ─────────────────────────────────────────
# EVAL_PHASE=15
# EVAL_SKIP_LIVE=1
