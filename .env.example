# =====================================================================
# Investor Ops & Intelligence Suite — Environment Variable Template
# Copy to .env.local and fill in values.
# The deployed Vercel app uses pre-configured keys; evaluators need not
# set these for the public demo (mock/degrade paths apply when missing).
# =====================================================================

# Supabase (Phase 7 — Data Layer)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<your-publishable-key>
# Server-side writes (eval persistence, reviews ingest, HITL). Recommended for local dev.
# SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>

# Google Gemini (Phase 8+ — RAG / pulse / voice orchestration)
# GEMINI_API_KEY=AIzaSy...

# ElevenLabs (Phase 10+ — Voice STT/TTS)
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_VOICE_ID=<voice-id>

# Google Calendar Service Account (Phase 10+ — Booking holds)
# GOOGLE_CLIENT_EMAIL=calendar-sa@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# TARGET_CALENDAR_ID=primary@advisor-calendar

# Optional — force mock calendar when SA keys unavailable (local / eval)
# CALENDAR_MOCK_MODE=true

# Eval scripts (Phase 15)
# EVAL_PHASE=15
# EVAL_SKIP_LIVE=1
